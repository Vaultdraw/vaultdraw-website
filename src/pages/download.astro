---
import Base from "../layouts/Base.astro";
import CodePanel from "../components/CodePanel.astro";
import Note from "../components/Note.astro";
import DownloadButton from "../components/DownloadButton.astro";
import CopyCommand from "../components/CopyCommand.astro";
import appIcon from "../assets/brand/app-icon-dark.svg";
import { RELEASE, SITE } from "../data/site.js";

const fileOf = (format) => RELEASE.linux.files.find((f) => f.arch === "x86_64" && f.format === format);
const linuxCards = [
  { for: "Debian, Ubuntu, Mint", format: ".deb", action: "Download .deb", href: fileOf("deb").url, file: fileOf("deb").file },
  { for: "Fedora", format: ".rpm", action: "Download .rpm", href: fileOf("rpm").url, file: fileOf("rpm").file },
  { for: "Any distribution, no install", format: "AppImage", action: "Download AppImage", href: fileOf("AppImage").url, file: fileOf("AppImage").file },
  { for: "Arch, Manjaro", format: "AUR", action: "Install from the AUR", href: "#aur", file: RELEASE.linux.aur.install },
];

const platforms = [
  { name: "macOS", detail: `${RELEASE.macs}, one universal DMG`, status: "Available", ready: true },
  { name: "Linux", detail: `${RELEASE.linux.archs}, .deb, .rpm, AppImage and AUR`, status: "Available", ready: true },
];
---

<Base
  title="Download"
  description={`Download Vaultdraw ${RELEASE.version} for macOS (Apple Silicon and Intel) and Linux (.deb, .rpm, AppImage, AUR). The builds are unsigned, so the first open on a Mac takes one extra step.`}
>
  <div class="dl wrap">
    <header class="dl__head">
      <img class="dl__icon" src={appIcon.src} width="64" height="64" alt="" />
      <p class="label">Download</p>
      <h1>Vaultdraw for <em>macOS</em> and <em>Linux</em>.</h1>
      <p class="dl__lead">
        Your Excalidraw drawings, in a folder you own. Free and open source, with no account.
      </p>
      <div class="dl__cta">
        <DownloadButton mac />
        <div class="dlbtn-linux">
          <a class="btn btn--solid" href="#linux">Download for Linux</a>
          <p class="dlbtn-linux__meta mono">.deb · .rpm · AppImage · AUR · {RELEASE.linux.archs}</p>
        </div>
        <a class="link-arrow" href={RELEASE.allUrl}>All releases</a>
      </div>
      <div class="dl__brew">
        <CopyCommand
          label="Or on macOS, with Homebrew"
          command={RELEASE.brew.install}
          caption="Installs the app and the <code>vaultdraw</code> command."
        />
      </div>
    </header>

    <ul class="dl__list" role="list">
      {
        platforms.map((p) => (
          <li class:list={["dl__item", { "dl__item--ready": p.ready }]}>
            <span class="dl__name">{p.name}</span>
            <span class="dl__detail mono">{p.detail}</span>
            <span class="dl__status mono">{p.status}</span>
          </li>
        ))
      }
    </ul>

    <section class="dl__sec" id="linux" aria-labelledby="linux-title">
      <h2 id="linux-title">Linux</h2>
      <p>
        Pick the file for your distribution. The package manager installs the libraries Vaultdraw needs (WebKitGTK 4.1, GTK 3, poppler).
      </p>
      <p class="dl__which">
        <strong>Which one?</strong> <code>.deb</code> for Debian, Ubuntu and Mint. <code>.rpm</code> for Fedora.
        AppImage for any other distribution, with no install and no root. AUR for Arch and Manjaro.
      </p>
      <ul class="dl__pkgs" role="list">
        {
          linuxCards.map((c) => (
            <li class="dl__pkg">
              <span class="dl__pkg-for">{c.for}</span>
              <span class="dl__pkg-fmt mono">{c.format}</span>
              <a class="btn btn--solid dl__pkg-btn" href={c.href}>{c.action}</a>
              <span class="dl__pkg-file mono">{c.file}</span>
            </li>
          ))
        }
      </ul>
      <div class="dl__code">
        <CopyCommand label="Debian, Ubuntu (x86_64)" command={RELEASE.linux.installDeb} caption="Run it in the folder you downloaded to." />
      </div>
      <div class="dl__code">
        <CopyCommand label="Fedora (x86_64)" command={RELEASE.linux.installRpm} />
      </div>
      <div class="dl__code">
        <CodePanel
          id="dl-appimage"
          note="terminal"
          files={[{ name: "AppImage", lang: "sh", code: RELEASE.linux.runAppImage }]}
        />
      </div>
      <div class="dl__code" id="aur">
        <CopyCommand
          label="Arch, Manjaro (AUR)"
          command={RELEASE.linux.aur.install}
          caption={`Or <code>${RELEASE.linux.aur.installParu}</code>.`}
        />
      </div>
      <p>
        Download <a href={RELEASE.sumsUrl}>SHA256SUMS</a> into the same folder as the file, then run{" "}
        <code>{RELEASE.linux.checksum}</code>. The builds are unsigned. They are new and were checked headless on Debian 12, Fedora and Arch, not on every desktop.
        Install, uninstall and limits are in <a href="/docs/install/#linux">Install</a>.
      </p>
    </section>

    <section class="dl__sec" aria-labelledby="open-title">
      <h2 id="open-title">Open it the first time</h2>
      <p>
        Vaultdraw isn't signed with an Apple Developer certificate, so macOS may refuse to open it the first time.
      </p>
      <ol class="dl__steps">
        <li>Open the DMG and drag Vaultdraw to Applications.</li>
        <li>
          Right-click (or Control-click) Vaultdraw and choose <strong>Open</strong>, then <strong>Open</strong> again.
          Or try to open it once, then go to <strong>System Settings → Privacy &amp; Security</strong> and click{" "}
          <strong>Open Anyway</strong>.
        </li>
        <li>
          If macOS says the app is "damaged", or the <code>vaultdraw</code> command stops with <code>Killed: 9</code>,
          run this in Terminal and try again:
          <div class="dl__code">
            <CodePanel
              id="dl-xattr"
              note="terminal"
              files={[
                {
                  name: "quarantine",
                  lang: "sh",
                  code: RELEASE.unquarantine,
                },
              ]}
            />
          </div>
        </li>
      </ol>
    </section>

    <section class="dl__sec" aria-labelledby="brew-title">
      <h2 id="brew-title">Homebrew</h2>
      <p>Same first-open step as the DMG. The cask lives in <a href={RELEASE.brew.tapUrl}>the Vaultdraw tap</a>.</p>
      <div class="dl__code">
        <CopyCommand label="Install" command={RELEASE.brew.install} />
      </div>
      <div class="dl__code">
        <CopyCommand label="Upgrade" command={RELEASE.brew.upgrade} />
      </div>
      <div class="dl__code">
        <CopyCommand label="Uninstall" command={RELEASE.brew.uninstall} />
      </div>
      <div class="dl__code">
        <CopyCommand
          label="Uninstall and also remove settings and caches"
          command={RELEASE.brew.zap}
          caption="Your vaults are never touched."
        />
      </div>
    </section>

    <section class="dl__sec" aria-labelledby="sum-title">
      <h2 id="sum-title">Check the download (optional)</h2>
      <p>
        Download <a href={RELEASE.sumsUrl}>SHA256SUMS</a> into the same folder as the DMG, then run this there:
      </p>
      <div class="dl__code">
        <CodePanel
          id="dl-sum"
          note="terminal"
          files={[
            {
              name: "checksum",
              lang: "sh",
              code: `cd ~/Downloads
shasum -a 256 -c SHA256SUMS`,
            },
          ]}
        />
      </div>
      <p>
        You should see <code>{RELEASE.dmgName}: OK</code>.
      </p>
    </section>

    <section class="dl__sec" aria-labelledby="know-title">
      <h2 id="know-title">Good to know</h2>
      <ul class="dl__know">
        <li>Windows is not available.</li>
        <li>There is no automatic update yet. Check <a href={RELEASE.allUrl}>All releases</a> for new versions.</li>
        <li>Plugins are experimental and their interface may change.</li>
        <li>
          Memory, measured on a quiet machine with three small drawings open: about 250 MB idle and
          a peak of about 470 MB. The opt-in <code>memory.low_memory_canvas</code> lowers the peak to about 365 MB, at about 60
          instead of 120 frames per second while panning.
        </li>
        <li>
          The <code>vaultdraw</code> command is optional. It is installed from the command palette (Cmd+Shift+P →{" "}
          <strong>Install 'vaultdraw' command in PATH</strong>), or by Homebrew.
        </li>
      </ul>
      <p>
        More in <a href="/docs/install/">Install</a> and <a href="/docs/troubleshooting/">Troubleshooting</a>.
      </p>
    </section>

    <section class="dl__src" aria-labelledby="src-title">
      <div>
        <h2 id="src-title">Build from source</h2>
        <p>
          You need Node 18 or newer, Yarn 1, and the <a href="https://tauri.app/start/prerequisites/">Rust and Tauri prerequisites</a>.
          The build takes a few minutes the first time.
        </p>
        <p>
          <a class="btn" href={RELEASE.allUrl}>All releases</a>
        </p>
      </div>
      <div>
        <CodePanel
          id="dl-build"
          note="terminal"
          files={[
            {
              name: "build",
              lang: "sh",
              code: `
git clone ${SITE.repo}
cd vaultdraw
yarn install
yarn desktop:build   # the app lands in excalidraw-desktop/src-tauri/target/release/bundle/`,
            },
          ]}
        />
        <Note arrow="up-left" class="dl__note">then open it and pick a folder</Note>
      </div>
    </section>
  </div>
</Base>

<style>
  .dl {
    padding-top: 64px;
  }

  .dl__head {
    max-width: 720px;
    margin-bottom: 40px;
  }

  .dl__icon {
    display: block;
    margin-bottom: 20px;
  }

  .dl__head h1 {
    margin: 16px 0 14px;
    font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4rem);
    font-weight: 380;
    letter-spacing: -0.02em;
  }

  .dl__lead {
    font-size: 1.2rem;
    color: color-mix(in srgb, var(--fg) 86%, var(--bg));
  }

  .dl__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px 28px;
    margin-top: 28px;
  }

  .dl__brew {
    max-width: 520px;
    margin-top: 28px;
  }

  .dl__list {
    margin: 0 0 72px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .dl__item {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .dl__name {
    font-size: 1.6rem;
  }

  .dl__detail,
  .dl__status {
    font-size: 0.76rem;
    color: var(--muted);
  }

  .dl__item--ready .dl__status {
    color: var(--accent);
  }

  .dl__sec {
    max-width: 720px;
    margin-bottom: 72px;
  }

  .dl__sec h2,
  .dl__src h2 {
    margin: 0 0 14px;
    font-size: 1.8rem;
    font-weight: 400;
  }

  .dl__steps,
  .dl__know {
    margin: 16px 0;
    padding-left: 1.4em;
  }

  .dl__steps li,
  .dl__know li {
    margin-bottom: 12px;
    padding-left: 0.3em;
  }

  .dl__which {
    margin: 12px 0 16px;
  }

  .dl__files {
    width: 100%;
    margin: 0 0 20px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .dl__files th,
  .dl__files td {
    padding: 8px 10px 8px 0;
    text-align: left;
    border-bottom: 1px solid var(--line-soft);
    overflow-wrap: anywhere;
  }

  .dl__files th {
    font-weight: 400;
    font-size: 0.76rem;
    color: var(--muted);
  }

  .dl__code {
    margin-top: 12px;
    min-width: 0;
  }

  .dl__sec .dl__code {
    margin-bottom: 16px;
  }

  .dl__src {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: 48px;
    align-items: start;
  }

  .dl :global(.dl__note) {
    margin: 14px 0 0 30%;
  }

  @media (max-width: 760px) {
    .dl__item {
      grid-template-columns: 1fr auto;
    }
    .dl__detail {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .dl__src {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .dlbtn-linux {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .dlbtn-linux__meta {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .dl__pkgs {
    list-style: none;
    margin: 24px 0 32px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .dl__pkg {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    
  }
  .dl__pkg-for {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .dl__pkg-fmt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .dl__pkg-btn {
    align-self: stretch;
    text-align: center;
    margin-top: 4px;
  }
  .dl__pkg-file {
    font-size: 0.7rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
</style>
