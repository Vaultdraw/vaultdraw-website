---
import Docs from "../../layouts/Docs.astro";
import { byGroup, docsInOrder } from "../../data/docs";

const groups = byGroup(await docsInOrder());
---

<Docs title="Documentation" description="How to use Vaultdraw: your vault, the command palette, themes, the config folder and the vaultdraw command.">
  {
    groups.map((g, gi) => (
      <section>
        <h2 class="index__g">{g.group}</h2>
        <ol class="index" role="list">
          {g.pages.map((p, i) => (
            <li>
              <a href={`/docs/${p.id}/`}>
                <span class="index__n mono">{`${gi + 1}.${i + 1}`}</span>
                <span class="index__t">{p.data.title}</span>
                <span class="index__d">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Docs>

<style>
  .index__g {
    margin: 48px 0 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .index {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .index a {
    display: grid;
    grid-template-columns: 3em 1fr;
    gap: 2px 0;
    padding: 18px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }

  .index a:hover .index__t {
    color: var(--accent);
  }

  .index__n {
    grid-row: span 2;
    padding-top: 0.45em;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .index__t {
    font-size: 1.35rem;
  }

  .index__d {
    color: var(--muted);
    font-size: 1rem;
  }
</style>
