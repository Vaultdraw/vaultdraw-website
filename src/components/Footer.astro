---
import Mark from "./Mark.astro";
import Wordmark from "./Wordmark.astro";
import { SITE } from "../data/site.js";
---

<footer class="foot">
  <div class="wrap foot__inner">
    <p class="foot__mark"><Mark variant="small" size={28} /><Wordmark height={22} /><span class="visually-hidden">Vaultdraw</span></p>
    <p class="foot__note">
      Built on <a href="https://github.com/excalidraw/excalidraw">Excalidraw</a> (MIT). Palettes in the{" "}
      <a href="https://github.com/noctalia-dev/noctalia">Noctalia</a> format, by their authors.
    </p>
    <p class="foot__note">This site sets no cookies and loads nothing from anyone else.</p>
    <nav class="foot__nav" aria-label="Footer">
      <a href="/docs/">Docs</a>
      <a href="/changelog/">Changelog</a>
      <a href="/download/">Download</a>
      <a href="/brand/">Brand</a>
      <a href={SITE.repo}>GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    margin-top: 120px;
    border-top: 1px solid var(--line-soft);
    padding-block: 48px 64px;
  }

  .foot__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 32px;
    align-items: baseline;
  }

  .foot__mark {
    margin: 0 0 10px;
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .foot__note {
    grid-column: 1;
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .foot__nav {
    grid-column: 2;
    grid-row: 2 / span 2;
    display: flex;
    gap: 20px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .foot__nav a {
    color: var(--muted);
    text-decoration: none;
    padding-block: 8px;
  }

  .foot__nav a:hover {
    color: var(--fg);
  }

  @media (max-width: 700px) {
    .foot__inner {
      grid-template-columns: 1fr;
    }
    .foot__nav {
      grid-column: 1;
      grid-row: auto;
      flex-wrap: wrap;
      margin-top: 16px;
    }
  }
</style>
