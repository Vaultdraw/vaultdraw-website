---
// A screenshot of the app in a window frame. Every featured theme has its own
// photo; theme.js swaps them when the visitor changes the site's theme.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { DEFAULT_THEME } from "../data/site.js";

interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
  /** A crop of the window rather than all of it: no window buttons. */
  partial?: boolean;
}

const { name, alt, eager = false, sizes = "(min-width: 1184px) 1120px, calc(100vw - 32px)", class: cls, partial = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.webp", { eager: true });
const WIDTHS = [720, 1120, 1680, 2240];

const variants: Record<string, { avif: string; webp: string; src: string }> = {};
let meta: ImageMetadata | undefined;
for (const [file, mod] of Object.entries(files)) {
  const key = file.split("/").pop()!.replace(".webp", "");
  if (!key.startsWith(`${name}-`)) continue;
  meta ??= mod.default;
  const [avif, webp] = await Promise.all(
    ["avif", "webp"].map((format) =>
      getImage({ src: mod.default, widths: WIDTHS, format: format as "avif" | "webp", quality: format === "avif" ? 60 : 78 }),
    ),
  );
  variants[key.slice(name.length + 1)] = {
    avif: avif.srcSet.attribute,
    webp: webp.srcSet.attribute,
    src: webp.src,
  };
}

const dark = variants[`${DEFAULT_THEME}-dark`];
const light = variants[`${DEFAULT_THEME}-light`] ?? dark;
if (!dark || !meta) throw new Error(`no screenshot "${name}-${DEFAULT_THEME}-dark"`);
---

<figure class:list={["shot", cls]} data-shot={name} data-variants={JSON.stringify(variants)} data-showing="theme">
  <div class="shot__frame">
    {!partial && <span class="shot__lights" aria-hidden="true"><i></i><i></i><i></i></span>}
    <picture data-current={`${DEFAULT_THEME}-dark`}>
      <source type="image/avif" media="(prefers-color-scheme: light)" srcset={light.avif} sizes={sizes} />
      <source type="image/webp" media="(prefers-color-scheme: light)" srcset={light.webp} sizes={sizes} />
      <source type="image/avif" srcset={dark.avif} sizes={sizes} />
      <source type="image/webp" srcset={dark.webp} sizes={sizes} />
      <img
        src={dark.src}
        alt={alt}
        width={meta.width / 2}
        height={meta.height / 2}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding="async"
        sizes={sizes}
      />
    </picture>
  </div>
  <slot />
</figure>

<style>
  .shot {
    margin: 0;
  }

  .shot__frame {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    border-radius: clamp(6px, 1.1cqw, 12px);
    border: 1px solid var(--line);
    background: var(--sunk);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--fg) 6%, transparent) inset,
      0 30px 80px -30px rgb(0 0 0 / 0.55),
      0 10px 24px -12px rgb(0 0 0 / 0.35);
  }

  .shot__frame img {
    width: 100%;
  }

  /* macOS window buttons, where the app leaves room for them. */
  .shot__lights {
    position: absolute;
    z-index: 1;
    top: 1.32cqw;
    left: 1.35cqw;
    display: flex;
    gap: 0.55cqw;
    transform: translateY(-50%);
  }

  .shot__lights i {
    width: 0.86cqw;
    height: 0.86cqw;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.25);
  }

  .shot__lights i:nth-child(2) {
    background: #febc2e;
  }

  .shot__lights i:nth-child(3) {
    background: #28c840;
  }

  .shot picture img {
    transition: opacity 0.3s ease;
  }
</style>
